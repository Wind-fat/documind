# ---- LLM（OpenAI 兼容）----
# 默认指向本机 magpie 网关；切到项目三的 aigate 只需改这两行
DOCUMIND_LLM_BASE_URL=http://127.0.0.1:3425/v1
DOCUMIND_LLM_API_KEY=magpie
DOCUMIND_LLM_MODEL=qwen-cn/qwen3.8-flash

# ---- 检索 ----
DOCUMIND_TOP_K=5
DOCUMIND_RECALL_N=30
# 由 `documind eval` 的 P-R 曲线标定，别手改（见 docs/adr/0004）
DOCUMIND_REFUSAL_RERANK_THRESHOLD=-6.0

# ---- 模型 ----
# auto=本地 bge；hash=CI/无模型环境（报告里会标注）
DOCUMIND_EMBED_BACKEND=auto
DOCUMIND_RERANK_BACKEND=auto
DOCUMIND_HF_ENDPOINT=https://hf-mirror.com

# ---- 安全 ----
DOCUMIND_ADMIN_TOKEN=dev-admin-token
DOCUMIND_SESSION_SECRET=dev-session-secret-change-me

# ---- 观测 ----
# 留空则 trace 落 data/traces/*.jsonl
DOCUMIND_LANGFUSE_PUBLIC_KEY=