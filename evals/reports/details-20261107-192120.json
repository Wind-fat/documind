      },
      {
        "id": "d617e3ae484c4ece-006",
        "strategy": "structure",
        "question": "副总经理是怎么聘任的？",
        "answerable": true,
        "refused": false,
        "answer": "副总经理由董事会聘任或解聘[2][3][4]；有的章程规定由总经理提请董事会聘任或者解聘[1][2]；有的章程规定由总经理提名，经董事会聘任或解聘[4]；有的章程还规定副总经理由总经理提名，董事会提名委员会进行资格审查并提出意见，由董事会聘任或解聘[3]。",
        "n_citations": 4,
